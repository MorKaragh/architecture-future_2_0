# Полный пример var-file для ручного запуска без scripts/terraform_env.sh.
# Скопируйте в prod.full.tfvars и заполните значения своего облака.

cloud_id       = "b1g..."
folder_id      = "b1g..."
zone           = "ru-central1-a"
subnet_id      = "e9b..."
ssh_public_key = "ssh-ed25519 AAAA... user@example"

vm_name = "future20-prod"

cores            = 8
memory           = 16
attach_disk_size = 200
attach_disk_type = "network-ssd"
boot_disk_size   = 50

labels = {
  environment = "prod"
  project     = "future20"
}

enable_nat = true
